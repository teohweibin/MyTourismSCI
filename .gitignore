# ============================================================
# MyTourismSCI .gitignore
# ============================================================
# COMMITTED: data/final/, outputs/, src/, config/, report/, docs/
# IGNORED:   data/raw/, data/processed/, docs/policy_documents/,
#            .env, .venv, IDE files, binary artefacts
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# --- Virtual environment ---
.venv/
venv/
ENV/
env/

# --- Environment variables (secrets) ---
.env

# --- Data: raw and processed are gitignored; final is committed ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Policy documents (large PDFs, not committed) ---
docs/policy_documents/*
!docs/policy_documents/.gitkeep

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Power BI temp files ---
*.pbix.tmp
.pbi/

# --- Claude Code ---
.claude/

# --- Large binary formats ---
*.zip
*.tar.gz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib

# --- Logs ---
*.log

# --- Coverage / profiling ---
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
